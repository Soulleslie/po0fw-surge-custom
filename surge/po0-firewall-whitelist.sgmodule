#!name=po0 防火墙自动加白
#!desc=Surge 启动、定时与网络切换时自动加白；面板自动刷新只查询状态，点击刷新会加白并在明细与简要状态间切换。支持多 token（英文逗号分割，对应多台机器）。
#!category=po0
#!author=reallinzc
#!arguments=tokens:"",interval_minutes
#!arguments-desc=tokens 填 pgnfw_ 开头的 API token（多台机器用英文逗号分隔，可加 @槽位，如 pgnfw_xxx@0）；interval_minutes 只填分钟数字，可选 1、2、3、4、5、6、10、12、15、20、30、60，填 15 即每 15 分钟。修改路径：Surge → 模块 → po0 防火墙自动加白 → 编辑参数 → interval_minutes

[Rule]
# 加白 API 必须直连，确保 API 看到的是本机真实出口 IP 而不是代理出口
IP-CIDR,124.221.69.228/32,DIRECT,no-resolve

[Script]
# po0-fw-start：Surge 引擎启动完成后立即加白一次（需 iOS 5.22.0+ / Mac 6.9.0+，旧版本不会触发这一行）
# 修改时间路径：Surge → 模块 → po0 防火墙自动加白 → 编辑参数 → interval_minutes（只填数字）
po0-fw-cron = type=cron,cronexp="*/{{{interval_minutes}}} * * * *",script-path=https://raw.githubusercontent.com/Soulleslie/po0fw-surge-custom/a76a303d725229a855bea331aa03d58e068cf4a2/scripts/po0-firewall-whitelist.js,timeout=60,argument="tokens={{{tokens}}}"
po0-fw-event = type=event,event-name=network-changed,script-path=https://raw.githubusercontent.com/Soulleslie/po0fw-surge-custom/a76a303d725229a855bea331aa03d58e068cf4a2/scripts/po0-firewall-whitelist.js,timeout=60,argument="tokens={{{tokens}}}"
po0-fw-start = type=event,event-name=engine-started,script-path=https://raw.githubusercontent.com/Soulleslie/po0fw-surge-custom/a76a303d725229a855bea331aa03d58e068cf4a2/scripts/po0-firewall-whitelist.js,timeout=60,argument="tokens={{{tokens}}}"
po0-fw-panel = type=generic,script-path=https://raw.githubusercontent.com/Soulleslie/po0fw-surge-custom/a76a303d725229a855bea331aa03d58e068cf4a2/scripts/po0-firewall-whitelist.js,timeout=60,argument="tokens={{{tokens}}}"

[Panel]
po0-fw = script-name=po0-fw-panel,title=po0 防火墙token,content=点击刷新并加白，再点切换简要,update-interval=300
