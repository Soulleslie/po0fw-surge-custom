#!name=po0 防火墙自动加白
#!desc=调用 po0 防火墙 API 将本机当前出口 IP 加入白名单。支持多 token（英文逗号分割，对应多台机器），network-changed 事件与用户填写分钟数的定时触发，附带手动刷新面板。
#!category=po0
#!author=reallinzc
#!arguments=tokens:"",interval_minutes
#!arguments-desc=tokens 填 pgnfw_ 开头的 API token（多台机器用英文逗号分隔，可加 @槽位，如 pgnfw_xxx@0）；interval_minutes 只填分钟数字，可选 1、2、3、4、5、6、10、12、15、20、30、60，填 15 即每 15 分钟。修改路径：Surge → 模块 → po0 防火墙自动加白 → 编辑参数 → interval_minutes

[Rule]
# 加白 API 必须直连，确保 API 看到的是本机真实出口 IP 而不是代理出口
IP-CIDR,124.221.69.228/32,DIRECT,no-resolve

[Script]
# 修改时间路径：Surge → 模块 → po0 防火墙自动加白 → 编辑参数 → interval_minutes（只填数字）
po0-fw-cron = type=cron,cronexp="*/{{{interval_minutes}}} * * * *",script-path=https://raw.githubusercontent.com/Soulleslie/po0fw-surge-custom/main/scripts/po0-firewall-whitelist.js,timeout=60,argument="tokens={{{tokens}}}"
po0-fw-event = type=event,event-name=network-changed,script-path=https://raw.githubusercontent.com/Soulleslie/po0fw-surge-custom/main/scripts/po0-firewall-whitelist.js,timeout=60,argument="tokens={{{tokens}}}"
po0-fw-panel = type=generic,script-path=https://raw.githubusercontent.com/Soulleslie/po0fw-surge-custom/main/scripts/po0-firewall-whitelist.js?v=panel-summary-1,timeout=60,argument="tokens={{{tokens}}}&interval_minutes={{{interval_minutes}}}"

[Panel]
po0-fw = script-name=po0-fw-panel,title=po0 防火墙状态,content=点击刷新查看状态,update-interval=300
